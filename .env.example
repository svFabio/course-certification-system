APP_NAME="Plataforma de Formación Continua"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# URL pública para enlaces en correos/QR (producción). Vacío = usa APP_URL.
APP_PUBLIC_URL=
ASSET_URL=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=plataforma_formacion
DB_USERNAME=plataforma
DB_PASSWORD=plataforma_secret
DB_SSLMODE=prefer
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail: log (solo desarrollo) | smtp (Gmail u otro SMTP real)
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@umss.edu.bo
MAIL_FROM_NAME="${APP_NAME}"

# Production port (docker-compose.prod.yml)
APP_PORT=80

# Google Sheets — exportar planillas de caja/docente
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=storage/app/google/credentials.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI="${APP_URL}/admin/google-sheets/callback"
SHEETS_EXPORT_CRON="0 */3 * * *"
SHEETS_EXPORT_DEBOUNCE_SECONDS=60

# Cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Telegram Channel Broadcast
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_CHAT_ID=

# Credenciales de prueba / Demo seeders
DEMO_ADMIN_EMAIL=admin@umss.edu.bo
DEMO_STUDENT_EMAIL=student@umss.edu.bo
DEMO_INSTRUCTOR_EMAIL=instructor@umss.edu.bo

